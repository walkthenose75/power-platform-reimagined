{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/power-platform-reimagined/synthetic-data-manifest/1-0-0",
  "title": "Synthetic Data Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataset", "sourceDataPolicy", "scenarios", "entities"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "sourceDataPolicy": {
      "const": "generated-from-approved-scenarios-no-source-rows"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "narrative"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "narrative": { "type": "string", "minLength": 1 },
          "edgeCases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logicalName", "file", "recordCount", "keyColumn", "loadOrder", "scenarioIds"],
        "properties": {
          "logicalName": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "pattern": "^[^\\\\]+\\.csv$" },
          "recordCount": { "type": "integer", "minimum": 0 },
          "keyColumn": { "type": "string", "minLength": 1 },
          "loadOrder": { "type": "integer", "minimum": 1 },
          "columnMap": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "scenarioIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["column", "targetEntity", "targetKey"],
              "properties": {
                "column": { "type": "string", "minLength": 1 },
                "targetEntity": { "type": "string", "minLength": 1 },
                "targetKey": { "type": "string", "minLength": 1 },
                "navigationProperty": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
